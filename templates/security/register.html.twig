{% extends 'base.html.twig' %}

{% block title %}Inscription - SportZone{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-body p-5">
                <h2 class="text-center mb-4">✍️ Inscription</h2>

                {{ form_start(registrationForm) }}
                    <div class="mb-3">
                        {{ form_label(registrationForm.email, 'Adresse email') }}
                        {{ form_widget(registrationForm.email, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(registrationForm.email) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(registrationForm.nom, 'Nom') }}
                        {{ form_widget(registrationForm.nom, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(registrationForm.nom) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(registrationForm.prenom, 'Prénom') }}
                        {{ form_widget(registrationForm.prenom, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(registrationForm.prenom) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(registrationForm.telephone, 'Téléphone (optionnel)') }}
                        {{ form_widget(registrationForm.telephone, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(registrationForm.telephone) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(registrationForm.password.first, 'Mot de passe') }}
                        {{ form_widget(registrationForm.password.first, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(registrationForm.password.first) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(registrationForm.password.second, 'Confirmez le mot de passe') }}
                        {{ form_widget(registrationForm.password.second, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(registrationForm.password.second) }}
                    </div>

                    <button type="submit" class="btn btn-success w-100 mb-3">S'inscrire</button>
                {{ form_end(registrationForm) }}

                <div class="text-center">
                    <p>Déjà un compte ? <a href="{{ path('app_login') }}">Connectez-vous</a></p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}